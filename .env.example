# Local/mock values only. Never commit a real .env.
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform?schema=public

# Auth.js
AUTH_SECRET=local-dev-only-not-a-real-secret-0123456789abcdef
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Generic OIDC provider. Locally this points at the mock-oauth2-server in docker-compose,
# which mimics an Entra ID v2.0 issuer: http(s)://<host>/<tenant-id>/v2.0
# For real Entra ID set: https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_OIDC_ISSUER=http://localhost:8080/11111111-1111-4111-8111-111111111111/v2.0
AUTH_OIDC_CLIENT_ID=internal-tools-local
AUTH_OIDC_CLIENT_SECRET=mock-client-secret
