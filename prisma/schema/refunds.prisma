// Owned by the refunds app (src/apps/refunds).

enum RefundStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum RefundReason {
  DAMAGED
  NOT_RECEIVED
  DUPLICATE_CHARGE
  WRONG_ITEM
  OTHER
}

model RefundRequest {
  id                String       @id @default(cuid())
  orderId           String       @map("order_id")
  customerEmail     String       @map("customer_email") // PII
  cardLast4         String       @map("card_last4") // PII
  amountCents       Int          @map("amount_cents")
  reason            RefundReason
  note              String?
  status            RefundStatus
  autoApproved      Boolean      @default(false) @map("auto_approved")
  createdByOid      String       @map("created_by_oid")
  createdByUsername String       @map("created_by_username")
  decidedByOid      String?      @map("decided_by_oid")
  decidedByUsername String?      @map("decided_by_username")
  decidedAt         DateTime?    @map("decided_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([createdByOid])
  @@index([status])
  @@map("refund_request")
}
